enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  CODING
  MCQ
  DESCRIPTIVE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model Assessment {
  id              String            @id @default(uuid())
  recruiterId     String            @map("recruiter_id")
  title           String
  description     String            @db.Text
  durationMinutes Int               @map("duration_minutes")
  passMarks       Float             @map("pass_marks")
  totalMarks      Float             @default(0) @map("total_marks")
  status          AssessmentStatus  @default(DRAFT)
  startTime       DateTime?         @map("start_time")
  endTime         DateTime?         @map("end_time")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  recruiter           RecruiterProfile       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  assessmentQuestions AssessmentQuestion[]
  invitations         AssessmentInvitation[]
  attempts            CandidateAttempt[]

  @@map("assessments")
}

model Question {
  id          String             @id @default(uuid())
  title       String
  description String             @db.Text
  type        QuestionType
  difficulty  QuestionDifficulty @default(MEDIUM)
  marks       Float              @default(10)
  testCases   Json?              @map("test_cases")
  options     Json?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  assessmentQuestions AssessmentQuestion[]
  submissions         Submission[]

  @@map("questions")
}

model AssessmentQuestion {
  id           String @id @default(uuid())
  assessmentId String @map("assessment_id")
  questionId   String @map("question_id")
  orderIndex   Int    @default(1) @map("order_index")

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}
