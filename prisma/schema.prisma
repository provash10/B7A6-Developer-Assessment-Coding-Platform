// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  CODING
  MCQ
  DESCRIPTIVE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  TIMED_OUT
}

enum PaymentProvider {
  BKASH
  STRIPE
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String            @map("password_hash")
  name         String
  phone        String?
  role         UserRole          @default(CANDIDATE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  recruiterProfile    RecruiterProfile?
  candidateProfile    CandidateProfile?
  payments            PaymentTransaction[]
  auditLogs           AuditLog[]

  @@map("users")
}

model RecruiterProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  companyName    String?
  companyWebsite String?
  companyLogo    String?
  credits        Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessments    Assessment[]

  @@map("recruiter_profiles")
}

model CandidateProfile {
  id              String                 @id @default(uuid())
  userId          String                 @unique
  resumeUrl       String?
  skills          String[]
  experienceYears Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations     AssessmentInvitation[]
  attempts        CandidateAttempt[]

  @@map("candidate_profiles")
}

model Assessment {
  id              String                 @id @default(uuid())
  recruiterId     String
  title           String
  description     String?
  durationMinutes Int
  passMarks       Float?
  totalMarks      Float                  @default(100.0)
  status          AssessmentStatus       @default(DRAFT)
  startTime       DateTime?
  endTime         DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?

  recruiter       RecruiterProfile       @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  invitations     AssessmentInvitation[]
  attempts        CandidateAttempt[]

  @@map("assessments")
}

model Question {
  id          String               @id @default(uuid())
  title       String
  description String
  type        QuestionType         @default(CODING)
  difficulty  Difficulty           @default(MEDIUM)
  marks       Float                @default(10.0)
  testCases   Json?
  options     Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  assessments AssessmentQuestion[]
  submissions Submission[]

  @@map("questions")
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  questionId   String
  orderIndex   Int        @default(1)
  createdAt    DateTime   @default(now())

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

model AssessmentInvitation {
  id           String           @id @default(uuid())
  assessmentId String
  candidateId  String
  inviteToken  String           @unique
  status       InviteStatus     @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("assessment_invitations")
}

model CandidateAttempt {
  id             String           @id @default(uuid())
  assessmentId   String
  candidateId    String
  status         AttemptStatus    @default(NOT_STARTED)
  startedAt      DateTime         @default(now())
  submittedAt    DateTime?
  totalScore     Float?
  isPassed       Boolean?
  antiCheatFlags Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  assessment     Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  submissions    Submission[]

  @@map("candidate_attempts")
}

model Submission {
  id             String           @id @default(uuid())
  attemptId      String
  questionId     String
  submittedCode  String?
  selectedOption String?
  verdict        String?
  scoreObtained  Float?
  executionTime  Int?             // in milliseconds
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attempt        CandidateAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model PaymentTransaction {
  id             String          @id @default(uuid())
  userId         String
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("BDT")
  provider       PaymentProvider
  transactionId  String          @unique
  status         PaymentStatus   @default(PENDING)
  paymentDetails Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_transactions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

 
