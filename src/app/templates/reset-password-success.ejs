<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Password Reset Successful</title>
    <style>
      body { font-family: Arial, sans-serif; background: #f7f7f7; color: #333; }
      .container { max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
      .success-box { display: inline-block; padding: 12px 24px; background: #e6fffa; color: #047857; font-size: 16px; font-weight: bold; border-radius: 4px; margin-top: 20px; }
      .footer { margin-top: 30px; font-size: 12px; color: #888; }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Password Reset Successful</h2>
      <p>Hello <%= name %>,</p>
      <div class="success-box">Your password has been successfully updated.</div>
      <p style="margin-top: 20px;">If you did not perform this action, please contact support immediately.</p>
      <div class="footer">&copy; Developer Assessment Platform. All rights reserved.</div>
    </div>
  </body>
</html>
