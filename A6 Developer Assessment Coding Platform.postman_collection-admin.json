				{
					"name": "5. Update User Role (Triggers Audit Log)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"RECRUITER\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/v1/users/:id/role",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"users",
								":id",
								"role"
							],
							"variable": [
								{
									"key": "id",
									"value": "USER_ID_HERE"
								}
							]
						},
						"description": "Admin updates a user's role (ADMIN, RECRUITER, CANDIDATE). This action automatically inserts a new entry into AuditLog."
