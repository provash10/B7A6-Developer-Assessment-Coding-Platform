					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "http://localhost:5000/api/v1/admin/dashboard-stats",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"admin",
								"dashboard-stats"
							]
						},
						"description": "Fetches overall system analytics including users count by role, active assessments count, question count, exam attempt pass rates, and total revenue in BDT from successful payments."
					},
					"response": []
				},
				{
					"name": "2. Get Audit Logs (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "http://localhost:5000/api/v1/admin/audit-logs?page=1&limit=10",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"admin",
								"audit-logs"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Retrieves system audit logs sorted by newest first with pagination and user performer details."
					},
					"response": []
				},
				{
