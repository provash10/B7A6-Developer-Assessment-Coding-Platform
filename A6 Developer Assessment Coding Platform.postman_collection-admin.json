							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"admin",
								"audit-logs"
							],
							"query": [
								{
									"key": "entityType",
									"value": "USER"
								},
								{
									"key": "action",
									"value": "USER_ROLE_UPDATED"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Filters audit logs by entityType (e.g. USER, ASSESSMENT) and action."
					},
					"response": []
				},
				{
					"name": "4. Get Audit Logs (Search Term)",
					"request": {
						"method": "GET",
						"header": [
