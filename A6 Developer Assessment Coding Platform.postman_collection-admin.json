						],
						"url": {
							"raw": "http://localhost:5000/api/v1/admin/audit-logs?searchTerm=ASSESSMENT&page=1&limit=10",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"admin",
								"audit-logs"
							],
							"query": [
								{
									"key": "searchTerm",
									"value": "ASSESSMENT"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Searches audit logs by keyword matching action, entityType, or entityId."
					},
					"response": []
