NODE_ENV=development
PORT=5000

# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/assessment_db?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/assessment_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Email / SMTP
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
EMAIL_SENDER=your_email@gmail.com

# bKash Sandbox Configuration
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback

# Seed & Test User Credentials
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@100.com"
ADMIN_PASSWORD="Password@100"

RECRUITER_NAME="Jane Recruiter"
RECRUITER_EMAIL="recruiter@100.com"
RECRUITER_PASSWORD="Password@100"

CANDIDATE_NAME="John Developer"
CANDIDATE_EMAIL="candidate@100.com"
CANDIDATE_PASSWORD="Password@100"
